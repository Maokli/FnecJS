{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "ESNext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "fnec": ["../FnecJS/packages/fnec/src/fnec.ts"],
      "fnec-renderer": ["../FnecJS/packages/fnec-renderer"],
      "fnec-transpiler": ["../FnecJS/packages/fnec-transpiler"],
      "fnec-shared": ["../FnecJS/packages/fnec-shared"],
      "fnec-scheduler": ["../FnecJS/packages/fnec-scheduler"]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}
